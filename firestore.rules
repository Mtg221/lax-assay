rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- admins ---
    // Only readable by the admin themselves (to check their own status);
    // never writable from the client. Admin documents are created manually
    // from the Firebase console / Admin SDK (see README "Admin initial").
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // --- products ---
    // Public can read only active products (applies to both single-doc
    // reads and list/query results — Firestore evaluates this per document).
    // Admin can read everything, active or not.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- colors ---
    // Public can read the color palette (needed to render swatches).
    // Only admin can manage it.
    match /colors/{colorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- shippingZones ---
    // Public can read zones/prices to compute the checkout total.
    match /shippingZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- settings ---
    // Public can read store settings (whatsapp number, hero, about, etc).
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- reviews ---
    // Public can create a pending review and read only approved ones.
    // Only admin can moderate (approve/refuse/delete) or read all.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == "Approuvé" || isAdmin();
      allow create: if request.resource.data.status == "En attente" &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() < 2000;
      allow update, delete: if isAdmin();
    }

    // --- counters ---
    // Used only inside the server-verified order transaction. No direct
    // client read/write outside of that transaction path; since Firestore
    // rules apply to transactions too, we allow the narrow update the
    // transaction performs (an authenticated context is not required for
    // guest checkout, but the counter can only ever be incremented by 1).
    match /counters/{counterId} {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // --- orders ---
    // Guests (no account) can create an order, but ONLY through the shape
    // the checkout transaction produces. Reading, listing, and updating
    // (status changes) is admin-only — customers never get a link that
    // lets them query other people's orders. The confirmation page passes
    // the order summary through client-side navigation state instead of a
    // Firestore read, so no public read access to /orders is needed at all.
    match /orders/{orderId} {
      allow read, list: if isAdmin();
      allow create: if request.resource.data.status == "En attente" &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.customerName is string &&
        request.resource.data.phone is string &&
        request.resource.data.address is string;
      allow update, delete: if isAdmin();
    }
  }
}
